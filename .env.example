# Optional: enables the LLM pass of the menu checker. Leave unset to run deterministic rules only.
# Any OpenAI-compatible chat-completions endpoint works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: LLM fallback for the site editor's command parser (apps/api).
# Without a key the editor still works with the deterministic parser only.
XAI_API_KEY=
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.20-0309-non-reasoning
# LLM_MAX_TOKENS=220

# API
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=restaurant_site_poc
PORT=4000
# Set to 1 to re-run the Astro build on publish
PUBLISH_BUILD=0

# Credits: parser commands and cache hits are free; each real AI call costs 1 credit.
CREDITS_DEFAULT=100
# What a credit would sell for; only used by the internal margin report (/dev, /api/admin/margin).
CREDIT_PRICE_USD=0.01
# Required for /api/admin/* (and the /dev page) when set; admin routes are closed in demo mode without it.
ADMIN_TOKEN=

# Public demo safeguards
DEMO_MODE=0
# Per-visitor sandboxes are deleted (TTL index) after this much inactivity.
SANDBOX_IDLE_MINUTES=60
# Global cap on real model spend per UTC day; "off" disables. Demo default 0.50.
LLM_DAILY_CAP_USD=
# Model calls per session / per IP per hour; "off" disables. Demo defaults 20 / 60.
LLM_RATE_PER_SESSION_HOUR=
LLM_RATE_PER_IP_HOUR=

# Hosted publish (non-demo): a static-host build hook to call on publish, e.g. a Cloudflare Pages deploy hook.
PUBLISH_HOOK_URL=
# Astro build: canonical origin, and where to fetch the published menu from (the API's /published.json).
SITE_URL=
MENU_URL=
# Admin: proxy /api to a separate Express server instead of the built-in route handlers.
API_URL=
