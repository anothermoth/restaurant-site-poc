{
  "name": "restaurant-site-poc",
  "private": true,
  "version": "0.1.0",
  "description": "Fast static restaurant site (Astro + React island), menu-quality checker, and a voice-driven, owner-approved site editor (Next.js + Express + MongoDB).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @restaurant-site-poc/site",
    "build": "npm run build -w @restaurant-site-poc/site",
    "preview": "npm run preview -w @restaurant-site-poc/site",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "check-menu": "tsx packages/menu-checker/src/cli.ts",
    "lighthouse": "./scripts/lighthouse.sh",
    "dev:api": "npm run dev -w @restaurant-site-poc/api",
    "dev:admin": "npm run dev -w @restaurant-site-poc/admin",
    "measure:tokens": "tsx scripts/measure-commands.ts",
    "demo:record": "node scripts/record-demo.mjs",
    "deploy:pages": "SITE_URL=${SITE_URL:-https://restaurant-site-poc.pages.dev} EDITOR_URL=${EDITOR_URL:-https://restaurant-site-poc-editor.vercel.app} npm run build -w @restaurant-site-poc/site && npx wrangler@4 pages deploy apps/site/dist --project-name restaurant-site-poc --branch main",
    "dev:admin:demo": "DEMO_MODE=1 npm run dev -w @restaurant-site-poc/admin",
    "photos:admin": "node scripts/admin-photos.mjs",
    "check:images": "node scripts/imgprobe.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
