---
import Base from "../layouts/Base.astro";
import Cart from "../components/Cart.tsx";
import Photo from "../components/Photo.astro";
import { cartMenu, menu } from "../lib/data.ts";
import { restaurantJsonLd } from "../lib/jsonld.ts";
import { allergenLine, dietWords, featureItem, menuPrice } from "@restaurant-site-poc/menu-schema/display";
import { withPhotoUrls } from "../lib/photos.ts";

const r = menu.restaurant;
const sections = menu.categories.filter((c) => !c.hidden);
const site = Astro.site!.toString();
const jsonLd = restaurantJsonLd(await withPhotoUrls(menu), site, { includeMenu: true });
---
<Base
  title={`Menu | ${r.name}`}
  description={`Full menu for ${r.name}: ${sections.map((c) => c.name).join(", ")}. Order online for pickup.`}
  jsonLd={jsonLd}
>
  <div class="menu-hero wrap">
    <p class="eyebrow eyebrow-dark">Order for pickup · {r.address.city}</p>
    <h1 class="title-xl">Menu</h1>
  </div>
  <nav class="cat-nav" aria-label="Menu sections">
    <div class="wrap cat-row">
      {sections.map((c) => <a href={`#${c.id}`} data-cat-link={c.id}>{c.name}</a>)}
    </div>
  </nav>

  <div class="wrap menu-body">
    {sections.map((c, n) => {
      const items = c.items.filter((i) => i.available);
      const feature = featureItem(items);
      return (
        <section class="menu-section" id={c.id} aria-labelledby={`${c.id}-h`} data-edit-id={`category:${c.id}`}>
          <header class="section-head">
            <h2 id={`${c.id}-h`} class="title">{c.name}</h2>
            {c.description && <p class="section-note">{c.description}</p>}
          </header>
          <div class:list={["section-body", { "has-feature": feature, "feature-left": n % 2 === 1 }]}>
            <ul class="menu-list">
              {items.map((i) => {
                const diet = dietWords(i.dietaryTags);
                const allergens = allergenLine(i.dietaryTags);
                return (
                  <li class="dish" id={i.id} data-edit-id={`item:${i.id}`}>
                    <div class="dish-line">
                      <h3 class="dish-name" data-edit-id={`item:${i.id}.name`}>{i.name}</h3>
                      <span class="dish-leader" aria-hidden="true"></span>
                      <span class="price" data-edit-id={`item:${i.id}.price`}><span class="sr-only">$</span>{menuPrice(i.price)}</span>
                      <button type="button" class="add-btn" data-add-item={i.id} aria-label={`Add ${i.name} to cart`}>
                        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                      </button>
                    </div>
                    {i.description && <p class="dish-desc" data-edit-id={`item:${i.id}.description`}>{i.description}</p>}
                    {(diet.length > 0 || allergens) && (
                      <p class="dish-notes">
                        {diet.map((d) => <span class:list={["diet", { "diet-spicy": d === "Spicy" }]}>{d}</span>)}
                        {allergens && <span class="allergen">{allergens}</span>}
                      </p>
                    )}
                  </li>
                );
              })}
            </ul>
            {feature?.photo && (
              <figure class="section-feature">
                <Photo class="feature-img" src={feature.photo.src} alt={feature.photo.alt} widths={[480, 720, 960]} sizes="(min-width: 1000px) 420px, 92vw" />
                <figcaption>{feature.name}</figcaption>
              </figure>
            )}
          </div>
        </section>
      );
    })}
    <p class="menu-legend">Prices in US dollars. Please tell us about any allergies when you order.</p>
  </div>
  <Cart client:idle menu={cartMenu} storageKey={`cart:${r.slug}`} />
  <script>
    // Highlight the category tab for the section in view (progressive enhancement).
    const links = new Map(
      [...document.querySelectorAll<HTMLAnchorElement>("[data-cat-link]")].map((a) => [a.dataset.catLink!, a]),
    );
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute("aria-current"));
          const a = links.get(e.target.id);
          if (a) {
            a.setAttribute("aria-current", "true");
            a.scrollIntoView({ block: "nearest", inline: "nearest" });
          }
        }
      },
      { rootMargin: "-140px 0px -60% 0px" },
    );
    document.querySelectorAll(".menu-section").forEach((s) => io.observe(s));
  </script>
</Base>
